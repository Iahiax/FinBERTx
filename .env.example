# Copy to .env and fill only credentials you have newly rotated.
# This template intentionally contains no account IDs, tokens, or API keys.
TRADING_MODE=paper

# One Capital.com credential set is shared by Demo and Live; the selected mode
# chooses the API host. Credentials are optional for Paper-only use.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
ENABLE_DEMO_ORDERS=false

# Live orders still require deliberate enablement and a second confirmation.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=

# Data-provider and Telegram credentials.
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_VERBOSE_STEPS=true

# Runtime and strategy safeguards.
# Historical name: this cap applies to Demo and Live broker attempts.
POLL_INTERVAL_SECONDS=60
MAX_OPEN_POSITIONS=1
MAX_DAILY_DEMO_ORDERS=1
MIN_SENTIMENT_CONFIDENCE=0.85
STOP_DISTANCE_PERCENT=0.5
TAKE_PROFIT_MULTIPLE=2
HIGH_IMPACT_BLACKOUT_BEFORE_MINUTES=15
HIGH_IMPACT_BLACKOUT_AFTER_MINUTES=10
MAX_NEWS_PER_CYCLE=10

# Paper sizing: 100:1 is a hard ceiling, never a target.
PAPER_STARTING_BALANCE=10000
PAPER_ACCOUNT_CURRENCY=USD
PAPER_MAX_LEVERAGE=100
PAPER_RISK_FRACTION=0.01
PAPER_DAILY_LOSS_LIMIT_FRACTION=0.03
MAX_EPIC_EXPOSURE_FRACTION=0.25

JOURNAL_PATH=data/finbertx.sqlite3
