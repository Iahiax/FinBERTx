# Read-only Capital.com demo market data; live host is never supported.
CAPITAL_ENV=demo
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
ENABLE_DEMO_ORDERS=false

# News and macro calendars
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

# Telegram: output channel/group; command senders must be allowlisted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_VERBOSE_STEPS=true

# Safety limits (the code also enforces hard upper bounds).
POLL_INTERVAL_SECONDS=60
MAX_OPEN_POSITIONS=2
MAX_DAILY_DEMO_ORDERS=5
MIN_SENTIMENT_CONFIDENCE=0.85
STOP_DISTANCE_PERCENT=0.5
TAKE_PROFIT_MULTIPLE=2
HIGH_IMPACT_BLACKOUT_BEFORE_MINUTES=15
HIGH_IMPACT_BLACKOUT_AFTER_MINUTES=10
MAX_NEWS_PER_CYCLE=10
BACKTEST_CSV=
BACKTEST_REPORT_INTERVAL_HOURS=24
JOURNAL_PATH=data/finbertx.sqlite3
